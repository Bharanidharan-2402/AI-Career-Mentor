# =========================================
# AI STUDENT CAREER MENTOR - CONFIGURATION
# =========================================
# Copy this file to .env and fill in your values

# ========== SERVER CONFIGURATION ==========
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ========== DATABASE (MongoDB) ==========
# Option 1: MongoDB Atlas (Cloud - Recommended)
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create free M0 cluster
# 3. Create database user and get connection string
# 4. Replace <username>:<password> and cluster name
MONGO_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/ai-career-mentor?retryWrites=true&w=majority

# Option 2: Local MongoDB
# MONGO_URI=mongodb://localhost:27017/ai-career-mentor

# ========== AUTHENTICATION ==========
# JWT Secret Key (change in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_very_long_secret_key_change_this_in_production

# ========== AI SERVICE (Google Gemini) ==========
# 1. Get API key at https://makersuite.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy and paste here
GEMINI_API_KEY=your_gemini_api_key_here

# ========== FRONTEND ==========
# URL where frontend is running (for CORS)
CLIENT_URL=http://localhost:5173

# ========== OPTIONAL ==========
# Database seed data
SEED_DATABASE=false

# Upload directory for resumes
UPLOAD_DIR=uploads

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=80

